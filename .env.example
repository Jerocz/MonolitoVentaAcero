# Copia este archivo como .env y cambia TODAS las claves antes de desplegar.
#   cp .env.example .env

# ---- Django ----
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=False
# IP elastica de AWS (o * mientras pruebas). Separadas por coma.
DJANGO_ALLOWED_HOSTS=*
# Solo si usas HTTPS o un dominio: https://midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Bases de datos (una por servicio) ----
VENTAS_DB_PASSWORD=cambia-ventas
CATALOGO_DB_PASSWORD=cambia-catalogo
PAGOS_DB_PASSWORD=cambia-pagos
FABRICACION_DB_PASSWORD=cambia-fabricacion

# ---- Pasarela de pago (ms-pagos): MOCK o REAL ----
ENV_TYPE=MOCK

# ---- API de terceros (tasa de cambio) ----
TASA_CAMBIO_API_URL=https://open.er-api.com
TASA_COP_USD_RESPALDO=0.00025

# ---- Servicio del equipo aliado (lo que consumimos) ----
ALIADO_NOMBRE=Equipo aliado
# Ejemplo: http://IP-DEL-ALIADO/api/su-endpoint
ALIADO_API_URL=

# ---- Resiliencia de llamadas HTTP ----
HTTP_TIMEOUT_SEGUNDOS=4
HTTP_REINTENTOS=2
CIRCUITO_UMBRAL_FALLOS=3
CIRCUITO_SEGUNDOS_ABIERTO=20
